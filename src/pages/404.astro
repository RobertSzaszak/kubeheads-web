---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Not found" description="That page does not exist.">
  <section class="section" style="text-align:center">
    <div class="wrap">
      <p class="mono muted" style="font-size:3rem;margin:0 0 .5rem">404</p>
      <h1>That page does not exist.</h1>
      <p class="lede" style="margin-inline:auto">
        It may have moved, or it may never have been here. Either way — nothing to see.
      </p>
      <div class="btn-row" style="justify-content:center">
        <a class="btn btn--primary" href="/">Back home</a>
      </div>
    </div>
  </section>
</BaseLayout>
