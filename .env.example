# Copy to `.env` and fill in. All PUBLIC_* vars are inlined into the built HTML —
# never put a secret here. These are all public-by-design tokens.

# ── Contact form (Web3Forms) ───────────────────────────────────────────────
# Get a key instantly at https://web3forms.com — enter hello@kubeheads.com and the
# key arrives by email. No dashboard signup. Free tier: 250 submissions/month.
# The key is public by design; it only allows posting to YOUR email.
PUBLIC_WEB3FORMS_KEY=

# ── Analytics (pick ONE, leave the other blank) ────────────────────────────
# Cloudflare Web Analytics — free, cookieless. Token from the Cloudflare dashboard
# under Analytics & Logs → Web Analytics. Recommended if hosting on Cloudflare Pages.
PUBLIC_CF_BEACON_TOKEN=

# Plausible — paid (~$9/mo), nicer UI, cookieless. Set to your domain, e.g. kubeheads.com
PUBLIC_PLAUSIBLE_DOMAIN=

# ── Search Console ─────────────────────────────────────────────────────────
# Only needed if you verify by meta tag rather than by DNS TXT record.
# DNS verification is better — it survives redeploys and covers all subdomains.
PUBLIC_GOOGLE_SITE_VERIFICATION=
