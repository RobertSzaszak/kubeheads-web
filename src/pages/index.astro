---
import BaseLayout from '../layouts/BaseLayout.astro';
import { HELP_AREAS, HOW_WE_HELP, PROMISES, SITE, mailto } from '../data/site';
---
<BaseLayout>
  <section class="hero">
    <div class="wrap">
      <p class="hero__kicker mono">AI &amp; technology consultancy</p>
      <h1>The agentic revolution is here.<br /><span class="grad-text">Don't get left behind.</span></h1>
      <p class="lede">
        Small business or large, we find the best and most cost-effective way to put AI and
        automation to work for you. We do the research and prove it works, so you can stay
        focused on running the company.
      </p>
      <div class="btn-row">
        <a class="btn btn--primary" href={mailto()}>Email us</a>
        <a class="btn btn--ghost" href="#how">How we help</a>
      </div>
      <ul class="promise">
        {PROMISES.map((p) => <li>{p}</li>)}
      </ul>
    </div>
  </section>

  <section class="section section--sunken">
    <div class="wrap">
      <p class="eyebrow">What we can help with</p>
      <div class="grid grid--4">
        {HELP_AREAS.map((a) => (
          <article class="card">
            <h3>{a.title}</h3>
            <p>{a.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="how">
    <div class="wrap">
      <p class="eyebrow">How we help</p>
      <h2>You run the business. We figure out the technology.</h2>
      <ol class="steps">
        {HOW_WE_HELP.map((s, i) => (
          <li>
            <span class="steps__num mono">0{i + 1}</span>
            <h3>{s.title}</h3>
            <p class="muted">{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--sunken cta">
    <div class="wrap cta__inner">
      <h2>What are you trying to solve?</h2>
      <p class="lede">
        Send us a few lines about your business and the problem. We reply within one working day.
      </p>
      <div class="btn-row">
        <a class="btn btn--primary" href={mailto()}>{SITE.email}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { padding-block: clamp(4rem, 12vw, 8.5rem) clamp(3rem, 8vw, 5.5rem); position: relative; overflow: hidden; }
  .hero::before {
    content: ''; position: absolute; inset: 0;
    background: radial-gradient(60ch 40ch at 12% -10%, color-mix(in srgb, var(--accent-2) 18%, transparent), transparent 70%);
    pointer-events: none;
  }
  .hero > .wrap { position: relative; }
  .hero__kicker { color: var(--text-faint); letter-spacing: .14em; text-transform: uppercase; font-size: .74rem; margin: 0 0 1.4rem; }
  .hero .lede { margin-top: 1.5rem; }

  .promise {
    list-style: none; margin: 2.5rem 0 0; padding: 0;
    display: flex; flex-wrap: wrap; gap: .75rem 1.75rem;
  }
  .promise li {
    position: relative; padding-left: 1.5rem;
    font-size: .95rem; color: var(--text);
  }
  .promise li::before {
    content: ''; position: absolute; left: 0; top: .45em;
    width: .8rem; height: .8rem; border-radius: 50%;
    background: var(--grad);
    box-shadow: 0 0 12px rgba(56, 189, 248, .5);
  }

  .grid--4 { margin-top: 1.5rem; }
  @media (min-width: 640px) { .grid--4 { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .grid--4 { grid-template-columns: repeat(4, 1fr); } }

  .steps { list-style: none; margin: 2.5rem 0 0; padding: 0; display: grid; gap: 1.5rem; }
  @media (min-width: 800px) { .steps { grid-template-columns: repeat(3, 1fr); gap: 2rem; } }
  .steps li { border-top: 2px solid; border-image: var(--grad) 1; padding-top: 1.1rem; }
  .steps__num { display: block; color: var(--accent-text); font-size: .76rem; letter-spacing: .1em; margin-bottom: .5rem; }
  .steps h3 { margin-bottom: .4rem; }
  .steps p { font-size: .98rem; margin: 0; }

  .cta__inner { text-align: center; display: flex; flex-direction: column; align-items: center; }
  .cta .lede { margin-inline: auto; }
  .cta .btn-row { justify-content: center; }
</style>
